{
  "name": "dev-daily-hub",
  "type": "module",
  "version": "5.0.0",
  "author": "Aidan Lowson <dev@aidanlowson.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AidanLDev/dev-daily-hub.git"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "astro": "astro",
    "build": "astro check --minimumSeverity warning && astro build",
    "deploy": "npx sst deploy --stage production",
    "dev": "astro dev",
    "astro:dev": "astro dev",
    "format": "prettier --write . --config .prettierrc.mjs",
    "format:check": "prettier --check . --config .prettierrc.mjs",
    "initSst": "npx sst start",
    "lint": "eslint --ext .js,.ts,.astro src",
    "preview": "astro preview",
    "sst:dev": "sst dev",
    "sst:remove": "sst remove --stage production",
    "start": "astro dev",
    "refresh": "npx sst refresh --stage production",
    "test:e2e": "playwright test",
    "test:e2e-open": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/tabler": "^1.2.41",
    "@sentry/astro": "^11.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "astro-pagefind": "^2.0.1",
    "astro-sst": "3.1.4",
    "aws-cdk-lib": "^2.272.0",
    "dayjs": "^1.11.23",
    "pagefind": "^1.5.2",
    "preline": "^5.0.0",
    "sharp": "^0.35.5",
    "sst": "^4.17.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "astro-eslint-parser": "^3.2.0",
    "constructs": "10.8.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sst-linux-x64": "^4.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "vscode-html-languageservice": "5.3.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md,astro}": "prettier --write --config .prettierrc.mjs",
    "**/*.d.ts": "prettier --write --config .prettierrc.mjs"
  }
}
